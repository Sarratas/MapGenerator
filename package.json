{
    "name": "mapgenerator",
    "version": "0.6.0",
    "description": "Generate and render a 2D hex map on an HTML5 canvas, with A* pathfinding.",
    "main": "index.js",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "webpack --progress --mode development",
        "build-production": "webpack --progress --mode production",
        "build-watch": "webpack --watch --progress --mode development",
        "start": "webpack serve --mode development",
        "test": "jest",
        "coverage": "jest --verbose --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Sarratas/MapGenerator.git"
    },
    "author": "Sarratas",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Sarratas/MapGenerator/issues"
    },
    "homepage": "https://github.com/Sarratas/MapGenerator#readme",
    "dependencies": {
        "fastpriorityqueue": "^0.8.0",
        "prando": "^6.0.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.0",
        "@swc/core": "^1.15.41",
        "@swc/jest": "^0.2.39",
        "@types/jest": "^30.0.0",
        "css-loader": "^7.1.2",
        "fork-ts-checker-webpack-plugin": "^9.1.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "sass": "^1.83.0",
        "sass-loader": "^16.0.4",
        "style-loader": "^4.0.0",
        "swc-loader": "^0.2.7",
        "typescript": "^6.0.3",
        "webpack": "^5.97.1",
        "webpack-cli": "^7.0.3",
        "webpack-dev-server": "^5.2.0"
    }
}
